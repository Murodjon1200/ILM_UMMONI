DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?schema=public&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?schema=public&sslmode=require"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Canonical public URL of the deployment. Set this via your host's environment
# configuration (never localhost in production).
# Local development: http://localhost:3000
NEXTAUTH_URL="https://your-production-domain.com"
AUTH_TRUST_HOST="true"
# Set to "true" only when a reverse proxy you control (nginx, Cloudflare, the
# hosting load balancer) always overwrites the forwarded IP headers. When this
# is not "true" forwarded headers are ignored and rate limiting falls back to a
# request fingerprint, so client IPs are never trusted from untrusted input.
TRUSTED_PROXY="false"
NEXT_PUBLIC_CENTER_PHONE="+998 __ ___ __ __"
NEXT_PUBLIC_CENTER_ADDRESS="Toshkent, O'zbekiston"
