{
  "name": "ilm-ummoni",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p $PORT",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
